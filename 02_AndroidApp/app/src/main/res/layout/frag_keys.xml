<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/octave"
            android:textColor="@color/dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnOctDown"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:text="-"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvOct"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/brand"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOctUp"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:text="+"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvBase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="C4"
            android:textColor="@color/dim"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timbre"
            android:textColor="@color/dim"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tim0"
                style="@style/TimbreBtn" />

            <Button
                android:id="@+id/tim1"
                style="@style/TimbreBtn" />

            <Button
                android:id="@+id/tim2"
                style="@style/TimbreBtn" />

            <Button
                android:id="@+id/tim3"
                style="@style/TimbreBtn" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tim4"
                style="@style/TimbreBtn" />

            <Button
                android:id="@+id/tim5"
                style="@style/TimbreBtn" />

            <Button
                android:id="@+id/tim6"
                style="@style/TimbreBtn" />

            <Button
                android:id="@+id/tim7"
                style="@style/TimbreBtn" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/hint_timbre"
            android:textColor="@color/dim"
            android:textSize="12sp" />
    </LinearLayout>

    <com.ti2.piano.PianoView
        android:id="@+id/piano"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/hint_keys"
        android:textColor="@color/dim"
        android:textSize="13sp" />

</LinearLayout>
